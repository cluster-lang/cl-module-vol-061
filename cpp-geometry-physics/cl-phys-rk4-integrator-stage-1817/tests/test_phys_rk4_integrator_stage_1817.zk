// cl-phys-rk4-integrator-stage-1817: Test Suite
import "../prk_1817.zk"

fn test_run():
    res := rk4_step_1817(10.0, 3.0, 3.0, 1.0)
    diff := res - 31.1700
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():

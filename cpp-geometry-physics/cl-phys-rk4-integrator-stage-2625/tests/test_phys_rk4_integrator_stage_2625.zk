// cl-phys-rk4-integrator-stage-2625: Test Suite
import "../prk_2625.zk"

fn test_run():
    res := rk4_step_2625(10.0, 3.0, 3.0, 1.0)
    diff := res - 39.2500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-phys-rk4-integrator-stage-2625!")

// cl-phys-rk4-integrator-stage-1320: Test Suite
import "../prk_1320.zk"

fn test_run():
    res := rk4_step_1320(10.0, 3.0, 3.0, 1.0)
    diff := res - 26.2000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():

import "../prk_1602.zk"

fn test_run():
    res := rk4_step_1602(10.0, 3.0, 3.0, 1.0)
    diff := res - 29.0200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():

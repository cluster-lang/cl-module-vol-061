// cl-phys-rk4-integrator-stage-2732: Test Suite
import "../prk_2732.zk"

fn test_run():
    res := rk4_step_2732(10.0, 3.0, 3.0, 1.0)
    diff := res - 40.3200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():

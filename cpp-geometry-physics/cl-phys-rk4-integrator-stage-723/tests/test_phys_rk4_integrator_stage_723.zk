// cl-phys-rk4-integrator-stage-723: Test Suite
import "../prk_723.zk"

fn test_run():
    res := rk4_step_723(10.0, 3.0, 3.0, 1.0)
    diff := res - 20.2300
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-phys-rk4-integrator-stage-723!")

import "../prk_1782.zk"

fn test_run():
    res := rk4_step_1782(10.0, 3.0, 3.0, 1.0)
    diff := res - 30.8200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():

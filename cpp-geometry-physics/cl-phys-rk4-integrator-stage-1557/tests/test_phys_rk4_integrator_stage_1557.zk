// cl-phys-rk4-integrator-stage-1557: Test Suite
import "../prk_1557.zk"

fn test_run():
    res := rk4_step_1557(10.0, 3.0, 3.0, 1.0)
    diff := res - 28.5700
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():

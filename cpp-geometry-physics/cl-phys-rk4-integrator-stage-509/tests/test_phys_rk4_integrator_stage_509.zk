// cl-phys-rk4-integrator-stage-509: Test Suite
import "../prk_509.zk"

fn test_run():
    res := rk4_step_509(10.0, 3.0, 3.0, 1.0)
    diff := res - 18.0900
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-phys-rk4-integrator-stage-509!")

// cl-phys-rk4-integrator-stage-1029: Test Suite
import "../prk_1029.zk"

fn test_run():
    res := rk4_step_1029(10.0, 3.0, 3.0, 1.0)
    diff := res - 23.2900
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():

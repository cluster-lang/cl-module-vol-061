// cl-phys-rk4-integrator-stage-1345: Test Suite
import "../prk_1345.zk"

fn test_run():
    res := rk4_step_1345(10.0, 3.0, 3.0, 1.0)
    diff := res - 26.4500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():

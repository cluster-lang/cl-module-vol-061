// cl-phys-rk4-integrator-stage-529: Test Suite
import "../prk_529.zk"

fn test_run():
    res := rk4_step_529(10.0, 3.0, 3.0, 1.0)
    diff := res - 18.2900
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-phys-rk4-integrator-stage-529!")

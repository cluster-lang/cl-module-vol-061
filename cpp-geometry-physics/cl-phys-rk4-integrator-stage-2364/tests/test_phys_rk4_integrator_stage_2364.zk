// cl-phys-rk4-integrator-stage-2364: Test Suite
import "../prk_2364.zk"

fn test_run():
    res := rk4_step_2364(10.0, 3.0, 3.0, 1.0)
    diff := res - 36.6400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():

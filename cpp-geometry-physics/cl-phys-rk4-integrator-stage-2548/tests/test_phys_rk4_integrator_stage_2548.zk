// cl-phys-rk4-integrator-stage-2548: Test Suite
import "../prk_2548.zk"

fn test_run():
    res := rk4_step_2548(10.0, 3.0, 3.0, 1.0)
    diff := res - 38.4800
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():

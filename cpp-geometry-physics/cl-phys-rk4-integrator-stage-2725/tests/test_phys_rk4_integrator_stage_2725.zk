// cl-phys-rk4-integrator-stage-2725: Test Suite
import "../prk_2725.zk"

fn test_run():
    res := rk4_step_2725(10.0, 3.0, 3.0, 1.0)
    diff := res - 40.2500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-phys-rk4-integrator-stage-2725!")

// cl-phys-rk4-integrator-stage-821: Test Suite
import "../prk_821.zk"

fn test_run():
    res := rk4_step_821(10.0, 3.0, 3.0, 1.0)
    diff := res - 21.2100
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
